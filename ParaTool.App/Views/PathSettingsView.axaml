<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:ParaTool.App.ViewModels"
			 x:Class="ParaTool.App.Views.PathSettingsView"
			 x:DataType="vm:PathSettingsViewModel">

	<Grid VerticalAlignment="Center" HorizontalAlignment="Center">
		<Border Background="{StaticResource PanelBgBrush}"
				CornerRadius="12"
				Padding="36,28"
				MinWidth="600">
			<StackPanel Spacing="20">

				<!-- Title -->
				<TextBlock Text="&#x1F4C1; Path Settings"
						   FontSize="{DynamicResource FontSize18}"
						   FontWeight="Bold" />

				<!-- ── Mods folder ──────────────────────────────────────── -->
				<StackPanel Spacing="6">
					<TextBlock FontSize="{DynamicResource FontSize12}"
							   Foreground="{StaticResource TextMutedBrush}"
							   Text="Mods folder — recursively scanned for .pak files (required):" />
					<Grid ColumnDefinitions="*,Auto">
						<TextBox Grid.Column="0"
								 Text="{Binding ModsFolderPath}"
								 IsReadOnly="True"
								 Watermark="Click &#x1F4C1; to select a folder…"
								 FontSize="{DynamicResource FontSize12}" />
						<Button Grid.Column="1"
								Name="BrowseModsFolderBtn"
								Content="&#x1F4C1;"
								FontSize="16"
								Margin="6,0,0,0"
								Padding="10,4"
								ToolTip.Tip="Browse for mods folder" />
					</Grid>
				</StackPanel>

				<!-- ── AMP pak file ─────────────────────────────────────── -->
				<StackPanel Spacing="6">
					<TextBlock FontSize="{DynamicResource FontSize12}"
							   Foreground="{StaticResource TextMutedBrush}"
							   Text="AMP .pak file — leave empty to auto-detect inside the mods folder:" />
					<Grid ColumnDefinitions="*,Auto,Auto">
						<TextBox Grid.Column="0"
								 Text="{Binding AmpPakFilePath}"
								 IsReadOnly="True"
								 Watermark="Auto-detect (REL_Full_Ancient_…)"
								 FontSize="{DynamicResource FontSize12}" />
						<Button Grid.Column="1"
								Name="BrowseAmpFileBtn"
								Content="&#x1F4C4;"
								FontSize="16"
								Margin="6,0,0,0"
								Padding="10,4"
								ToolTip.Tip="Browse for AMP .pak file" />
						<Button Grid.Column="2"
								Command="{Binding ClearAmpPathCommand}"
								Content="&#x2715;"
								Margin="4,0,0,0"
								Padding="8,4"
								ToolTip.Tip="Clear — revert to auto-detect"
								IsVisible="{Binding AmpPakFilePath,
									Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
					</Grid>
				</StackPanel>

				<!-- Validation error -->
				<TextBlock Text="{Binding ValidationError}"
						   Foreground="{StaticResource ErrorBrush}"
						   FontSize="{DynamicResource FontSize12}"
						   IsVisible="{Binding ValidationError,
							   Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

				<!-- Action buttons -->
				<StackPanel Orientation="Horizontal" Spacing="8"
							HorizontalAlignment="Right" Margin="0,4,0,0">
					<Button Command="{Binding CancelCommand}"
							Content="Cancel"
							Padding="16,8"
							FontSize="{DynamicResource FontSize13}" />
					<Button Command="{Binding ApplyCommand}"
							Content="&#x2714; Apply &amp; Rescan"
							Padding="16,8"
							FontSize="{DynamicResource FontSize13}" />
				</StackPanel>

			</StackPanel>
		</Border>
	</Grid>

</UserControl>
